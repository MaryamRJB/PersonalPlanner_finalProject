<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/taskCard"

    android:layout_width="match_parent"
    android:layout_height="140dp"

    android:layout_margin="5dp"
    android:padding="12dp">


    <!-- ========================= -->
    <!-- عنوان -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/title"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:fontFamily="@font/kara"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#303030"

        android:gravity="center"
        android:textAlignment="center"

        android:maxLines="2"
        android:ellipsize="end"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================= -->
    <!-- ساعت -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/timeContainer"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:orientation="horizontal"
        android:gravity="center"

        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"

        android:background="@drawable/item_analystic_background"

        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/progressContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:id="@+id/clock"

            android:layout_width="16dp"
            android:layout_height="16dp"

            android:layout_marginEnd="5dp"

            app:srcCompat="@drawable/clock_ic" />


        <TextView
            android:id="@+id/startTime"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:fontFamily="@font/kara"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#444444"

            android:gravity="center" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- Progress -->
    <!-- ========================= -->

    <FrameLayout
        android:id="@+id/progressContainer"

        android:layout_width="52dp"
        android:layout_height="52dp"

        android:layout_marginTop="8dp"

        app:layout_constraintTop_toBottomOf="@id/timeContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.progressindicator.CircularProgressIndicator

            android:id="@+id/progressBar"

            android:layout_width="46dp"
            android:layout_height="46dp"

            android:layout_gravity="center"

            android:max="100"
            android:progress="0"

            app:indicatorSize="42dp"
            app:trackThickness="4dp"
            app:trackColor="#55FFFFFF"
            app:indicatorColor="#555555" />


        <TextView
            android:id="@+id/progressPercent"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center"
            android:textAlignment="center"

            android:fontFamily="@font/kara"
            android:textSize="10sp"
            android:textStyle="bold"

            android:textColor="#555555" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>