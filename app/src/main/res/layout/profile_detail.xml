<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#D7CAF3"
    tools:context=".ProfileActivity">


    <!-- ========================= -->
    <!-- دکمه برگشت -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/btnBackArrow"

        android:layout_width="32dp"
        android:layout_height="32dp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"

        android:src="@drawable/ic_arrow_back"

        android:clickable="true"
        android:focusable="true"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ========================= -->
    <!-- کارت اصلی -->
    <!-- ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileCard"

        android:layout_width="0dp"
        android:layout_height="500dp"

        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:layout_marginTop="120dp"

        android:background="@drawable/rounded_background_profile"

        android:elevation="4dp"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="25dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ========================= -->
        <!-- عکس پروفایل -->
        <!-- ========================= -->


        <!-- ========================= -->
        <!-- نام -->
        <!-- ========================= -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgProfile"

            android:layout_width="90dp"
            android:layout_height="90dp"

            android:layout_marginTop="64dp"

            android:elevation="8dp"

            android:scaleType="centerCrop"

            android:src="@drawable/profile_ic"

            android:translationY="-45dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ProfileImageShape" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="160dp"
            android:background="@drawable/profile_field"
            android:fontFamily="@font/kara"
            android:gravity="center"
            android:hint="نام کاربری"
            android:inputType="textPersonName"
            android:padding="10dp"
            android:textColor="#303030"
            android:textColorHint="#8B8795"
            android:textSize="16sp"
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/profile_field"
            android:enabled="false"
            android:fontFamily="@font/kara"
            android:gravity="center"
            android:hint="شماره تلفن"
            android:inputType="phone"
            android:padding="10dp"
            android:textColor="#303030"
            android:textColorHint="#8B8795"
            android:textSize="16sp"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/etName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/etWakeUpTime"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/profile_field"
            android:clickable="true"
            android:focusable="false"
            android:fontFamily="@font/kara"
            android:gravity="center"
            android:hint="ساعت بیداری"
            android:maxLines="1"
            android:padding="10dp"
            android:textColor="#303030"
            android:textColorHint="#8B8795"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etPhone" />

        <EditText
            android:id="@+id/etSleepTime"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/profile_field"
            android:fontFamily="@font/kara"
            android:gravity="center"
            android:hint="ساعت خواب"
            android:focusable="false"
            android:clickable="true"
            android:padding="10dp"
            android:textColor="#303030"
            android:textColorHint="#8B8795"
            android:textSize="16sp"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/etWakeUpTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <android.widget.Button
            android:id="@+id/btnConfirm"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/profile_button"
            android:fontFamily="@font/kara"
            android:text="خروج از حساب"
            android:textColor="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>