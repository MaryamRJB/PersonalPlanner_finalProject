<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fccac2">

    <ImageView
        android:id="@+id/btnBackArrow"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="70dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:background="@drawable/rounded_background_profile"
        android:padding="16dp">

        <!-- عنوان -->
        <TextView
            android:id="@+id/taskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:text="یادگیری هوش مصنوعی"
            android:gravity="center"
            android:fontFamily="@font/kara"
            tools:ignore="MissingConstraints" />

        <!-- خط جداکننده اول -->
        <View
            android:id="@+id/dividerOne"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:background="#CCCCCC"
            app:layout_constraintTop_toBottomOf="@+id/taskTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- لایه ساعت و اولویت -->
        <LinearLayout
            android:id="@+id/timePriorityLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/dividerOne"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/priorityCircle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_circle_priority"
                android:layout_marginEnd="10dp"
                />

            <TextView
                android:id="@+id/startTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:fontFamily="@font/kara"
                android:text="۱۰:۰۰ تا ۲۱:۰۰"
                android:layout_marginEnd="10dp"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                app:srcCompat="@drawable/clock_ic"/>

        </LinearLayout>

        <!-- خط جداکننده دوم -->
        <View
            android:id="@+id/dividerTwo"
            android:layout_width="120dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:background="#CCCCCC"
            app:layout_constraintTop_toBottomOf="@+id/timePriorityLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/subTaskHeader"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="5dp"
            android:fontFamily="@font/kara"
            android:gravity="center"
            android:text="لیست زیرکارها:"
            android:textColor="#FFFFFF"
            android:background="@drawable/sub_task_header_background"
            app:layout_constraintTop_toBottomOf="@id/dividerTwo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnGenerateSubTasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="تقسیم کار به زیرکارها"
            android:fontFamily="@font/kara"
            app:layout_constraintTop_toBottomOf="@id/subTaskHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subTask"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintTop_toBottomOf="@id/btnGenerateSubTasks"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>